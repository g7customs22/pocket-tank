# Append after sdkconfig.defaults, with a separate SDKCONFIG and build directory.
CONFIG_POCKET_TANK_WAVESHARE_349_V1=y
CONFIG_POCKET_TANK_DISPLAY_SH8601=n
CONFIG_POCKET_TANK_TOUCH_FT3168=n
CONFIG_POCKET_TANK_AUDIO_ES8311=y
CONFIG_SPIRAM_MEMTEST=y

# Brief recovery only when RTC time is invalid; no continuous Wi-Fi.
CONFIG_ESP_WIFI_ENABLED=y
CONFIG_POCKET_TANK_WIFI_TIME_RECOVERY=y

CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=4

CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=8

CONFIG_ESP_WIFI_STATIC_TX_BUFFER=y

CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER=n

CONFIG_ESP_WIFI_STATIC_TX_BUFFER_NUM=4

CONFIG_ESP_WIFI_CACHE_TX_BUFFER_NUM=4

CONFIG_ESP_WIFI_RX_BA_WIN=4

CONFIG_ESP_WIFI_IRAM_OPT=n

CONFIG_ESP_WIFI_RX_IRAM_OPT=n
